region = "ap-southeast-1"

networking = {
  cidr_block         = "10.0.0.0/16"
  availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]
  public_subnet_ips  = ["10.0.1.0/24", "10.0.2.0/24"]
  private_subnet_ips = ["10.0.10.0/24", "10.0.20.0/24"]
}

security = {
  # Only this public IP can SSH to the Control Node.
  control_node_cidr = "203.0.113.10/32"
}

compute = {
  image_id      = "ami-0532913178263be11"
  instance_type = "t3.medium"
  key_name      = "dcjewelry-keypair"
  keypair_path  = "./keypair/key.pub"
}

database = {
  identifier        = "dcjewelry-database"
  name              = "dcjewelry"
  username          = "admin"
  # Set this only in your local terraform.tfvars. Never commit a real password.
  password          = "REPLACE_WITH_YOUR_RDS_PASSWORD"
  engine_version    = "8.0"
  instance_class    = "db.t3.medium"
  allocated_storage = 20
  storage_type      = "gp3"
  multi_az          = false
}
