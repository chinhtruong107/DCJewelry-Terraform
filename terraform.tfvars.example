region = "ap-southeast-1"

networking = {
  cidr_block         = "10.0.0.0/16"
  availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]
  public_subnet_ips  = ["10.0.1.0/24", "10.0.2.0/24"]
  private_subnet_ips = ["10.0.10.0/24", "10.0.20.0/24"]
}

security = {
  # Only this public IP can SSH to the Control Node.
  control_node_cidr = "203.0.113.10/32"
}

compute = {
  image_id      = "ami-0532913178263be11"
  instance_type = "t3.medium"
  key_name      = "dcjewelry-keypair"
  keypair_path  = "./keypair/key.pub"
}

database = {
  identifier        = "dcjewelry-database"
  name              = "dcjewelry"
  username          = "admin"
  # Set this only in your local terraform.tfvars. Never commit a real password.
  password          = "REPLACE_WITH_YOUR_RDS_PASSWORD"
  engine_version    = "8.0"
  instance_class    = "db.t3.medium"
  allocated_storage = 20
  storage_type      = "gp3"
  multi_az          = false
}

# PMM Server stays in a private subnet. A t3.medium and 30 GiB disk are a
# reasonable baseline for this lab; reduce retention before choosing smaller resources.
monitoring = {
  image_id      = "ami-0532913178263be11"
  instance_type = "t3.medium"
  key_name      = "dcjewelry-keypair"
  volume_size   = 30
}

observability = {
  alert_topic_name   = "dcjewelry-infrastructure-alerts"
  log_retention_days = 30
  cpu_threshold_percent    = 80
  memory_threshold_percent = 85
  disk_threshold_percent   = 85
  rds_free_storage_gib     = 5
  telegram_bot_token = "PASTE_YOUR_TELEGRAM_BOT_TOKEN"
  telegram_chat_id   = "PASTE_YOUR_TELEGRAM_CHAT_ID"
}
